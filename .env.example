# Copy to .env and adjust. Read by git_backup/config.py via python-dotenv.
# Comma-separated GitHub users/orgs whose repositories are backed up.
GITHUB_OWNERS=your-user,your-org
# Folder (relative to the project) that receives repos/<owner>/<name> clones.
BACKUP_DIR=repos
# Folder for timestamped log files.
LOG_DIR=logs
# Folder for the generated size report.
REPORT_DIR=reports
# Include forked repositories (true/false).
INCLUDE_FORKS=true
# Number of repositories cloned/updated at the same time.
PARALLEL_JOBS=4
# How many rows the "largest" tables in the report show.
REPORT_TOP_N=40
